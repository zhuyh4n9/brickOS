# {{name}} — product declaration surface (human-written; **product-level single source of truth**, BRV-D4 / §8.2)
#
# Generated once by `brickie init`, then **maintained by hand** — brickie never overwrites human-written files (§9.1.1).
# Plan comes from `brickie-core plan-init`; content is rendered by `brickie-gen render` (contract §4/§6).
schema = {{schema}}

[product]
name     = "{{name}}"
version  = "{{version}}"       # COMPAT_GEN.MAJOR.MINOR.REVISE
# Every root is a record: `brick` names the plugin, `requires` carries that brick's own version
# requirement (`{}` = none). The rest of the image joins by each plugin's `[[dep]]` closure.
app      = { brick = "{{app}}", requires = {} }                       # exactly one APP
platform = { brick = "", requires = {} }                              # fill in: platform/<board>
core     = { brick = "", requires = { version = "{{CORE_RANGE}}" } }  # fill in: core/c_core
stage    = "dev"               # dev | release (profile default, CLI can override)

# Directly selected abilities: one `[[product.ability]]` block, one `<alias> = { ... }` per plugin.
# The alias is a label only -- the plugin identity always comes from `brick`.
[[product.ability]]
# console = { brick = "driver/uart-pl011", requires = {} }
# rootfs  = { brick = "fs/tmpfs", requires = {} }

[budget]
ram_kib   = 512
stack_kib = 16

[kernel]
# Tick frequency in Hz (cf. Linux CONFIG_HZ): timer interrupts per second.
# Default (omitted) = 200 ⇒ 5 ms per tick. brickie build turns it into -DBR_CFG_TICK_HZ for
# every compilation unit — the platform reload period and core jiffies read the same macro (ADR-0017).
hz = 200

[lint]
frozen_deps = "inherit"       # inherit | allow | deny
allow_edges = []

[build]
# ============================================================ build policy (`brickie build`)
#
# ★ **Without it, `brickie build` fails with `BRV-BLD-0001`.** The image's source set and flags are
#   computed from the **declaration surface** (ADR-0004 / S1–S3 of design ADR-0003), no longer literals in a hand-written Makefile:
#     · per-plugin sources/includes   → each plugin's brick.toml `[build]`
#     · target facts (arch/cross prefix/linker script) → the platform plugin's `[build.target]`
#     · this table                    → product-level policy (flags + output locations)
#   The default below is the minimal usable set for "AArch64 bare-metal ELF, no libc" — every entry has a reason:
#     -ffreestanding / -fno-builtin   no host runtime assumptions; loops are not silently turned into memcpy
#     -fno-stack-protector            no libc __stack_chk_fail
#     -fno-omit-frame-pointer         **compile-time prerequisite** for stack traces (service/backtrace): -O2 drops fp
#     -fno-pic / -fno-pie             bare metal, no relocations
#     -ffunction-sections/-fdata-sections + -Wl,--gc-sections   unused code stays out of the image
gen_sources   = []                                    # whether `brickie gen` outputs (descriptors etc.) go into the image
obj_dir       = "build/obj"

cflags = [
  "-std=c11", "-O2", "-g3",
  "-Wall", "-Wextra", "-Werror", "-Wshadow", "-Wundef", "-Wpointer-arith",
  "-Wstrict-prototypes", "-Wmissing-prototypes",
  "-ffreestanding", "-fno-builtin", "-fno-common", "-fno-stack-protector",
  "-ffunction-sections", "-fdata-sections",
  "-fno-pic", "-fno-pie",
  "-fno-asynchronous-unwind-tables", "-fno-unwind-tables",
  "-fno-omit-frame-pointer",
]
asflags = ["-g3"]
ldflags = [
  "-nostdlib", "-nostartfiles", "-static", "-no-pie",
  "-Wl,--build-id=none", "-Wl,--gc-sections", "-Wl,-z,max-page-size=4096",
]
# Linker script (`-Wl,-T`) and `-Wl,-Map` are injected by the tool (the former from the platform's `[build.target]`),
# not repeated here — one writable place per fact.

# [build.release]                 # flags **appended** with `--profile release` (optional)
# cflags_extra = ["-DNDEBUG"]
