# {{name}} — 插件声明面(人写; **插件级唯一真值**, BRV-D4)
#
# 由 `brickie new` 生成一次, 之后**由人维护** —— brickie 不覆盖人写文件(§8.4)。
# 字段语义: docs/4-plugin/4-03-plugin-manifest.md; v0.1 schema: brickie-v0.1 §8.1
schema = {{schema}}

[plugin]
name        = "{{name}}"
plugin_type = "platform"
api_type    = "{{api_type}}"
lang        = "{{lang}}"
phase       = "{{phase}}"      # 内存 region 表必须在 EARLY 声明(`3-01` §7)
version     = "{{version}}"        # COMPAT_GEN.MAJOR.MINOR.REVISE(§5.2)
summary     = "{{summary}}"
license     = "{{license}}"

[compat]
core       = ">=1.0.0"      # range 固定 3 段, 缺段右补 0(§7.4)
api_rev    = 1
hash_scope = "decl"                # decl(v0.1) | sym(v0.x)(§6.6)
truth      = "decl"                # decl | header(§6.6)
abi_id     = ""                    # v0.1 占位; v0.6 由工具链指纹填充

# ---- 接口依赖(v0.2 启用; v0.1 只校验 schema)----
# [[compat.requires_iface]]
# id         = "ability/vfs-core#file"   # <provider>#<unit>
# api_iface  = "native"
# compat_gen = 0                         # 必填, 精确匹配(§5.5)
# range      = ">=1.2.0"                 # 只比较 MAJOR.MINOR.REVISE
# mode       = "decl"

# ---- 类型别名表(IFACE-IR 规则 4 的输入, §6.2)----
# 别名 → 规范名; 防"同一类型两种写法"抖 hash。骨架为空, 有别名时再填。
[iface.typedefs]

# ---- 结构依赖(init / runtime / type; **不钉 compat_gen**)----
# [[dep]]
# name  = "platform/qemu-aarch64"
# range = ">=0.1.0"
# kind  = "init"
# phase = "early"                  # 可选断言(§8.1); 与提供方自述冲突 ⇒ BRV-DEP-0010

# ---- 导出面(每单元一条; 单元 = 冻结与版本的基本粒度, 依 F1)----
[[export]]
api_iface    = "{{export_api_iface}}"      # §3.5 不变量 1: 必须等于 [plugin].api_type
form         = "{{export_form}}"               # api | skin | service(§8.4 的骨架取 api)
name         = "{{export_name}}"
version      = "{{version}}"       # 单元自身四段版本(按单元推进)
compat_gen   = 0                   # 单元级冻结代; 0 = 尚未冻结(§5.3)
freeze_state = "unfrozen"          # unfrozen | frozen | unfreezing(§5.3.1)
hash         = ""                  # 由 `brickie iface publish` 填充(§6.2)
status       = "experimental"      # experimental | frozen | deprecated
# [[export.entries]]               # 符号级"意图"清单(§6.1)
# kind   = "func"
# name   = "{{symbol_prefix}}do_something"
# sig    = "int (void)"
# status = "experimental"

# ---- 特权面(§3.4; v0.1 只校验声明合法性)----
# [privileged]
# level = "P2"
# [[privileged.memory]]
# granularity = "page"
# ops         = ["map", "protect", "flush", "invalidate"]
# regions     = ["dma"]

[build]                            # ★ `brickie build` 消费它(ADR-0004): 源集合 + 包含路径
sources  = ["src/*.c"]
includes = ["include"]

# ------------------------------------------------------------------ 目标事实(必填!)
# `brickie build` 从**唯一一个** platform 插件的本表取 arch / 交叉前缀 / arch 标志 /
# 链接脚本 / QEMU 型号(每镜像恰一个 platform, §8.3 ④)。
#
# ⚠ **不填它 ⇒ `brickie build` 直接报 `BRV-BLD-0003`**(退出码 2)—— 这是刻意的:
#   模板**不能替你知道** SoC 的事实(arch 是什么、链接脚本在哪、QEMU 用哪个机器型号);
#   猜一个值只会把错误推到"镜像跑不起来"那一步。把下面的注释按你的板子填实。
#
# [build.target]
# arch          = "aarch64"                  # 目标架构(呈现/诊断用)
# cross         = "aarch64-linux-gnu-"       # 交叉前缀; 工具候选序由 core 定(contract §9 R-14)
# arch_flags    = ["-march=armv8-a", "-mgeneral-regs-only", "-mstrict-align"]
# linker_script = "src/link.ld"              # 相对**本插件根**
#
# [build.target.qemu]
# binary  = "qemu-system-aarch64"
# machine = "virt,gic-version=3"             # ⚠ 机器型号要钉住(GICv2/GICv3 差别会静默地收不到中断)
# cpu     = "cortex-a53"
# memory  = "128M"
# extra   = ["-nographic"]
