{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "build/index/dependents.json — v0.1 反向依赖索引(BRV-D2: 单条记录形状)",
  "description": "形状对齐 contract §5.1 的 `dep-index` data: `{dependents: {<plugin>: [{from, kind}]}}`。只在 `dependents` 存在时校验其值形状; 索引内容由 brickie-core 产出(§8 禁止 L5 拼接机器文件内容)。",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema": {
      "type": "integer",
      "minimum": 0
    },
    "dependents": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["from", "kind"],
          "additionalProperties": true,
          "properties": {
            "from": {"type": "string"},
            "kind": {
              "type": "string",
              "enum": ["init", "runtime", "type"]
            }
          }
        }
      }
    }
  }
}
