{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "brickie.lock - v0.1 lock file (BRV-D2: single-record shape)",
  "description": "Shape is defined by this file (contract §7.3 only says 'see lock.schema.json'). v0.1 is weak validation: neither the top level nor any section has required - the lock's field set is still being settled (checklist W-17 'does the lock carry freeze generation' undecided), and tightening would misjudge hand-written or early-core output as a schema error. Known form: schema + [lock]{profile, plugins[], units[]} (+ an implementation-defined [lock.product]); cross-field invariants (version monotonicity, closure completeness) are reported by core.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema": {
      "type": "integer",
      "minimum": 0
    },
    "protocol": {
      "type": "integer",
      "minimum": 0
    },
    "lock": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["dev", "release"]
        },
        "product": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "name": {"type": "string"},
            "version": {"type": "string"},
            "stage": {
              "type": "string",
              "enum": ["dev", "release"]
            }
          }
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "name": {"type": "string"},
              "version": {"type": "string"},
              "compat_gen": {"type": "integer", "minimum": 0}
            }
          }
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "id": {"type": "string"},
              "provider": {"type": "string"},
              "unit": {"type": "string"},
              "api_iface": {
                "type": "string",
                "enum": ["native", "runtime_adapter", "third_party"]
              },
              "version": {"type": "string"},
              "compat_gen": {"type": "integer", "minimum": 0},
              "hash": {"type": "string"},
              "hash_scope": {
                "type": "string",
                "enum": ["decl", "sym"]
              },
              "truth": {
                "type": "string",
                "enum": ["decl", "header"]
              }
            }
          }
        }
      }
    }
  }
}
