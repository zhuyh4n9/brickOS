{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tests/gates.toml - v0.1 gate declaration surface (BRV-D2: single-record shape)",
  "description": "Shape matches contract §7.4. Expresses single-record shape only (field names/types); the regex subset (supports . * + ? [...] \\x, not ( ) | ^ $ { }), gate-name uniqueness, whether names in [build].post exist, and log pass/fail decisions are all decided by brickie-core as BRV-BLD-0008..0012 (ruling R-16: decisions live in core, L5 only executes). This file does NOT participate in L5 shape gate (not registered in schema.py SCHEMA_FILES) - gate decisions belong to core, not to L5 allowed duties.",
  "type": "object",
  "required": ["schema"],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "type": "integer",
      "enum": [1]
    },
    "run": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "default_timeout_s": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "cc": {
          "type": "string"
        },
        "cflags": {
          "type": "array",
          "items": {"type": "string"}
        },
        "bin_dir": {
          "type": "string"
        }
      }
    },
    "hosttest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "sources"],
        "additionalProperties": true,
        "properties": {
          "name": {"type": "string"},
          "sources": {
            "type": "array",
            "items": {"type": "string"}
          },
          "includes": {
            "type": "array",
            "items": {"type": "string"}
          },
          "defines": {
            "type": "array",
            "items": {"type": "string"}
          },
          "depends": {
            "type": "array",
            "items": {"type": "string"}
          },
          "timeout_s": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "gate": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": true,
        "properties": {
          "name": {"type": "string"},
          "timeout_s": {
            "type": "integer",
            "minimum": 0
          },
          "log": {"type": "string"},
          "require": {
            "type": "array",
            "items": {"type": "string"}
          },
          "forbid": {
            "type": "array",
            "items": {"type": "string"}
          },
          "require_tags": {
            "type": "array",
            "items": {"type": "string"}
          },
          "expect": {
            "type": "string",
            "enum": ["timeout"]
          }
        }
      }
    },
    "script": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "argv"],
        "additionalProperties": true,
        "properties": {
          "name": {"type": "string"},
          "argv": {
            "type": "array",
            "items": {"type": "string"}
          },
          "require": {
            "type": "array",
            "items": {"type": "string"}
          },
          "forbid": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "post": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
