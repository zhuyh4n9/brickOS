{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "product.toml - brickie v0.1 product selection surface (BRV-D2: single-record shape)",
 "description": "Expresses single-record shape only (contract §7.2). Cross-field/cross-file invariants ('exactly one app', 'select.plugins globally unique', budget vs closure) are reported as codes by brickie-core.",
 "type": "object",
 "required": [
  "schema",
  "product"
 ],
 "additionalProperties": true,
 "properties": {
  "schema": {
   "type": "integer",
   "enum": [
    1
   ]
  },
  "product": {
   "type": "object",
   "required": [
    "name",
    "app"
   ],
   "additionalProperties": true,
   "properties": {
    "name": {
     "type": "string"
    },
    "version": {
     "type": "string"
    },
    "app": {
     "type": "string"
    },
    "core": {
     "type": "string"
    },
    "stage": {
     "type": "string",
     "enum": [
      "dev",
      "release"
     ]
    }
   }
  },
  "select": {
   "type": "object",
   "additionalProperties": true,
   "properties": {
    "plugins": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "budget": {
   "type": "object",
   "additionalProperties": true,
   "properties": {
    "ram_kib": {
     "type": "integer",
     "minimum": 0
    },
    "stack_kib": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "kernel": {
   "type": "object",
   "description": "Tick frequency (like Linux CONFIG_HZ): timer interrupts per second. Absent table / omitted hz = default 200 (one tick per 5 ms). brickie build turns the value into -DBR_CFG_TICK_HZ for all translation units (ADR-0017).",
   "additionalProperties": true,
   "properties": {
    "hz": {
     "type": "integer",
     "minimum": 1,
     "description": "Timer interrupts per second (Hz). Common values 100/200/250/1000; the upper bound is enforced by a _Static_assert in br_time.h."
    }
   }
  },
  "lint": {
   "type": "object",
   "additionalProperties": true,
   "properties": {
    "frozen_deps": {
     "type": "string",
     "enum": [
      "inherit",
      "allow",
      "deny"
     ]
    },
    "allow_edges": {
     "type": "array",
     "items": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "build": {
   "type": "object",
   "additionalProperties": true,
   "properties": {
    "core_sources": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "core_includes": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "gen_sources": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "cflags": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "asflags": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "ldflags": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "obj_dir": {
     "type": "string"
    },
    "release": {
     "type": "object",
     "additionalProperties": true,
     "properties": {
      "cflags_extra": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "asflags_extra": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "ldflags_extra": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    "selftest_sources": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Source set of the core selftest suite (ADR-0010; not compiled when selftest is off). Separate from core_sources because core_sources globbing would cover core/selftest/**."
    }
   }
  },
  "selftest": {
   "type": "object",
   "description": "ADR-0010: global selftest switch + optional plugin list. Absent table = follow [product].stage (dev on / release off).",
   "additionalProperties": true,
   "properties": {
    "enabled": {
     "description": "true/false explicit; the string \"inherit\" = follow stage (same as the default).",
     "oneOf": [
      {
       "type": "boolean"
      },
      {
       "type": "string",
       "enum": [
        "inherit"
       ]
      }
     ]
    },
    "plugins": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Run only the listed plugins; an empty array = every plugin that declares [selftest]."
    }
   }
  }
 }
}
