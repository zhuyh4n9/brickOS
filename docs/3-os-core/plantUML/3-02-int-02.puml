@startuml
' brickOS 3-02 中断管理 — 核心数据结构类图
'
' ── 布局约束(改图前必读) ──────────────────────────────────────────────
' 1) 这是【结构关系图】, 不是调用图: 实线 = 包含/绑定关系(带重数), 虚线 = "经 core 调用/凭据"。
' 2) 类体只列字段名与类型, 不写文档字符串 —— 字段语义在正文 §14.4 的表里, 图里重复会拉宽每格。
' 3) 关系线的方向不加箭头(association), 让 dot 自行选择层次; 加了箭头会强制层级导致长边交叉。
' 4) 新增类时优先复用现有类的关联锚点, 不要引入新的"中心类"。
' 5) ★ "配置/身份" 与 "运行期计数" 分属两个类(br_irq_desc_t / br_irq_rt_t), 二者都按 virq 下标平行
'    索引 —— 这是刻意的: 前者布局入 golden 且长期不动, 后者是可以增删计数的运行状态(§3.3)。

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype polyline

class br_irq_binding_t <<platform .rodata(flash), 16 B>> {
  virq : uint16
  pic_id : uint8
  flags : uint8
  hwirq : uint32
  dom_id : int8
  prio : uint8
  trigger : uint8
  dispatch : uint8
  rsv[3] : uint8
}

class br_irq_desc_t <<core 池, 下标 = virq, 32 B>> {
  isr : void (*)(void *)
  arg : void *
  hwirq : uint32
  flags : uint16
  depth : uint16
  prio : uint8
  trigger : uint8
  pic_id : int8
  dom_id : int8
  sub : uint16
  rsv : uint16
}

class br_irq_rt_t <<独立运行期表, 下标 = virq, 8 B>> {
  count : uint32
  storm : uint16
  epoch : uint16
}

class br_irq_domain_t <<core 池, 56 B>> {
  name : const char *
  ops : br_irq_domain_ops *
  priv : void *
  parent_virq : uint16
  virq_base : uint16
  n_sub : uint16
  flags : uint16
  sub_desc : br_irq_desc_t *
  bitmap : uint32 *
  nwords : uint16
  id : uint8
  rsv : uint8
  busy : uint16
  drop_count : uint16
}

class br_irq_domain_ops <<域方言: 驱动填表>> {
  pending(priv, bits, nwords)
  mask(priv, sub)
  unmask(priv, sub)
  ack(priv, sub)
}

class br_pic_ops_t <<控制器方言: ISA 库填表>> {
  init(pic)
  caps_get(pic, out)
  ack(pic) : uint32
  eoi(pic, hwirq)
  mask / unmask(pic, hwirq)
  set_prio / set_trigger(pic, hwirq, v)
  set_running_prio(pic, prio)
  set_affinity(pic, hwirq, mask)
}

class br_pic_caps_t <<能力声明: 决定降级行为>> {
  prio_bits : uint8
  nr_irq : uint32
  caps : uint32
}

class br_irq_cpu_t <<per-CPU, TPIDR_EL1>> {
  current : br_thread_t *
  irq_depth : uint32
  saved_daif : uint32
  isr_nest : uint32
  in_fault : uint32
  isr_seq : uint32
  storm_total : uint32
  spurious_owned : uint32
  spurious_nocap : uint32
  curr_virq : uint16
  in_handler : uint16
  prev_fault_ec : uint32
  prev_fault_elr : uint64
}

class br_irq_state_t <<golden 位布局, 32 bit>> {
  bit0 : 进入前 PSTATE.I
  bit1 : 进入前 PSTATE.F
  bit2 : 进入前 PSTATE.A
  bit3 : 进入前 PSTATE.D
  bit17_4 : depth 副本
  bit31_18 : 保留
}

class br_irq_dispatch_t <<仅 BR_IRQ_DISPATCH_DYNAMIC=1>> {
  mode : uint8
  flags : uint8
  worker : uint16
  threshold : uint32
}

class br_fault_ctx_t <<fault handler 入参, 只读现场>> {
  esr / far / elr / spsr : uint64
  sp : uint64
  ec : uint32
  in_isr / isr_nest : uint32
  isr_virq / handler_idx : uint16
  cpu_id / vector_slot : uint32
  tsc : uint64
  tcb : const void *
  prev_ec / prev_elr
  frame : const uint64 *
}

br_irq_binding_t "1" -- "1" br_irq_desc_t : 组合期生成 / init 初始化
br_irq_binding_t "1" -- "1" br_irq_rt_t : 同一 virq 的两种视图
br_irq_desc_t "1" -- "1" br_irq_rt_t : 平行数组, 同下标
br_irq_domain_t "1" *-- "n" br_irq_desc_t : sub_desc[n_sub]
br_irq_desc_t "1" -- "0..1" br_irq_domain_t : dom_id >= 0
br_irq_domain_t "1" -- "1" br_irq_domain_ops : 域方言
br_irq_desc_t ..> br_pic_ops_t : 经 core 调用(ack/eoi/mask)
br_pic_ops_t -- br_pic_caps_t : 能力上报
br_irq_desc_t *-- br_irq_dispatch_t : 可选内嵌
br_irq_cpu_t ..> br_irq_state_t : lock/unlock 凭据
br_irq_cpu_t ..> br_fault_ctx_t : fault 现场来源
@enduml
