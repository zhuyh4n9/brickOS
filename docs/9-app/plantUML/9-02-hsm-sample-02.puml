@startuml
' 布局约束: 只用 state 与直连迁移; 不要给多状态挂同一条 note(dot 会把 note 甩到远端, 拉长整图)。
skinparam state {
  BackgroundColor #F8F8F8
  BorderColor #555555
}
state "VACANT\n空槽位" as VACANT
state "CREATED\n材料就位, 尚不可用" as CREATED
state "ACTIVE\n用途位已绑定(SIGN/VERIFY/CRYPT)" as ACTIVE
state "SUSPENDED\n策略触发 / 运维挂起" as SUSPENDED
state "DESTROYED\n材料清零 + 墓碑(不可逆)" as DESTROYED

[*] --> VACANT
VACANT --> CREATED : GEN / IMPORT(策略允许)
CREATED --> ACTIVE : ACTIVATE(绑定用途位)
ACTIVE --> SUSPENDED : SUSPEND / 计数达上限
SUSPENDED --> ACTIVE : RESUME
CREATED --> DESTROYED : DESTROY
ACTIVE --> DESTROYED : DESTROY
SUSPENDED --> DESTROYED : DESTROY
DESTROYED --> [*] : 墓碑持久化(handle 永久失效 → -ENODEV)
@enduml
